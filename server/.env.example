# Model pentru server/.env (care NU se urca in Git).
# Copiaza acest fisier ca server/.env si completeaza valorile reale.

# --- Open WebUI: motorul de conversatie (Docker) ---
# OPENWEBUI_KEY: cheia de API din Open WebUI, Settings -> Account -> API keys.
OPENWEBUI_URL=http://localhost:3000
OPENWEBUI_KEY=your_open_webui_api_key_here

# --- Agent 051 (RECON), program separat, prin MCP ---
# 127.0.0.1, nu host.docker.internal: clientul MCP e serverul JA.S.Mine, nu
# containerul. MCP_TOKEN e acelasi ca in .env-ul agentului.
RECON_MCP_URL=http://127.0.0.1:8051/mcp
MCP_TOKEN=your_long_random_token_here

# --- COMMS: raportul de mail, doar citire (IMAP) ---
# GMAIL_APP_PASSWORD nu este parola contului Google, ci o "parola de aplicatie"
# generata separat din setarile de securitate Google.
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password_here
GMAIL_FOLDER_COMMS=INBOX
# Optional: o eticheta Gmail ale carei mesaje nu intra in raport (de exemplu
# alertele de joburi pe care le citeste deja agentul 051). Gol = niciuna.
GMAIL_ETICHETA_EXCLUSA=
